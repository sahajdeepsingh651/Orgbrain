# Postgres (used by docker-compose.yml and backend/db/migrate.py)
POSTGRES_USER=orgbrain
POSTGRES_PASSWORD=orgbrain
POSTGRES_DB=orgbrain

# Full connection string the backend reads directly.
# Host-side port is 5433 (not Postgres' usual 5432) — see docker-compose.yml.
DATABASE_URL=postgresql://orgbrain:orgbrain@localhost:5433/orgbrain

# Bearer-token-to-identity map (backend/app/auth.py). Default path is repo-root config/api_tokens.json —
# copy config/api_tokens.example.json there and fill in real tokens/identities. Override the path here if needed.
# API_TOKENS_FILE=config/api_tokens.json

# Which identity backend/mcp_server.py runs as — must be a token present in api_tokens.json.
MCP_API_TOKEN=replace-with-a-real-secret-token
